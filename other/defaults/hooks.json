[
  {
    "id": "github",
    "execute-command": "/usr/local/bin/deploy.sh",
    "pass-file-to-command": [
      { "source": "entire-payload", "name": "payload" }
    ],
    "trigger-rule": {
      "match": {
        "type": "payload-hash-sha256",
        "secret": "CHANGE_ME_LONG_RANDOM",
        "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
      }
    }
  }
]
