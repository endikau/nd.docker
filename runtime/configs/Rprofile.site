local({
  p3m_repo <- "https://packagemanager.posit.co/cran/__linux__/noble/latest"
  cran_repo <- "https://cloud.r-project.org"
  repos <- c(P3M = p3m_repo, CRAN = cran_repo)

  options(
    repos = repos,
    download.file.method = "libcurl",
    renv.config.ppm.enabled = TRUE,
    renv.config.ppm.default = TRUE,
    renv.config.rspm.enabled = TRUE,
    renv.config.repos.override = repos,
    HTTPUserAgent = sprintf(
      "R/%s R (%s)",
      getRversion(),
      paste(
        getRversion(),
        R.version[["platform"]],
        R.version[["arch"]],
        R.version[["os"]]
      )
    )
  )
})
